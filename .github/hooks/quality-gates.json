{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "python3 .github/hooks/checks.py pre",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "python3 .github/hooks/checks.py post",
        "timeoutSec": 30
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "python3 .github/hooks/checks.py stop",
        "timeoutSec": 120
      }
    ]
  }
}
